#!/usr/bin/env python3

import re
import subprocess
import sys
from collections import defaultdict

EXERCISE_RE = re.compile(r"\\begin\{exercise\}[\{\[]([^}\]]+)[\}\]]")
UNLABELED_RE = re.compile(r"\\begin\{exercise\}(?![\{\[])")
SOL_START_RE = re.compile(r"\\begin\{sol\}")
SOL_END_RE = re.compile(r"\\end\{sol\}")
EXERCISE_END_RE = re.compile(r"\\end\{exercise\}")


def chapter_key(label):
    return label.split(".")[0] if "." in label else label[0]


def sort_key(label):
    if "." in label:
        return tuple(int(x) for x in label.split("."))
    # Axler format: 1A5
    return (int(label[0]), label[1], int(label[2:]))


def collect_edits(diff_text):
    found = defaultdict(set)
    current_file = current_exercise = None
    in_solution = False

    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            current_file = line[6:]
            current_exercise, in_solution = None, False
            continue
        if line.startswith(("@@", "---", "diff ")):
            continue

        content = line[1:] if line[:1] in "+- " else line

        if UNLABELED_RE.search(content):
            print(f"Warning: unlabeled exercise in {current_file}", file=sys.stderr)

        if m := EXERCISE_RE.search(content):
            current_exercise = m[1]
            in_solution = False
        elif SOL_START_RE.search(content):
            in_solution = True
        elif SOL_END_RE.search(content) or EXERCISE_END_RE.search(content):
            in_solution = False
        elif line.startswith("+") and in_solution and current_exercise:
            found[chapter_key(current_exercise)].add(current_exercise)

    return found


def build_message(found):
    chapters = sorted(found, key=lambda ch: (int(ch) if ch.isdigit() else ch))
    subject = f"fix: chapter{'s' if len(chapters) > 1 else ''} {', '.join(chapters)}\n\n"
    body = "\n".join(
        ", ".join(sorted(found[ch], key=sort_key))
        for ch in chapters
    )
    return subject + body


def main():
    msg_file = sys.argv[1]
    source = sys.argv[2] if len(sys.argv) > 2 else ""
    if source not in ("", "template"):
        return

    diff = subprocess.run(
        ["git", "diff", "--cached", "-U999999"],
        capture_output=True, encoding="utf-8", errors="replace"
    ).stdout

    found = collect_edits(diff)
    if found:
        with open(msg_file, "w") as f:
            f.write(build_message(found))


if __name__ == "__main__":
    main()